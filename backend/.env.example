# Copy to backend/.env and supply secrets locally. Never commit .env.
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
DEBUG=False
ALLOWED_HOSTS=attendanceerpbackend.onesmarter.com,localhost,127.0.0.1

DB_NAME=onesmarte_db
DB_USER=OneSmarterUser
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

FRONTEND_ORIGIN=https://myportal.onesmarter.com
CORS_ALLOWED_ORIGINS=https://myportal.onesmarter.com,https://my-one-smarter-portal.vercel.app
CSRF_TRUSTED_ORIGINS=https://attendanceerpbackend.onesmarter.com,https://myportal.onesmarter.com,https://my-one-smarter-portal.vercel.app

# Set True after Nginx HTTPS is configured.
SECURE_SSL_REDIRECT=False

EMAIL_HOST=smtp.ionos.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=support@onesmarter.com
